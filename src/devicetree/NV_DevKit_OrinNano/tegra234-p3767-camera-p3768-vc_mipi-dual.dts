/dts-v1/;
/plugin/;

#include <dt-bindings/tegra234-p3767-0000-common.h>

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>

#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_PWDN	TEGRA234_MAIN_GPIO(AC, 0)
#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)

// ------------------------------------------------------------------------------------------------
//  Driver Configuration for NVIDIA Jetson Orin Nano/Orin NX on NVIDIA Jetson Orin Nano Developer Kit
// ------------------------------------------------------------------------------------------------
#define VC_MIPI_CAM_0       1   // 1: Enabled, 0: Disabled  (serial_b => CSI Port 1 => VI Stream 0)
#define VC_MIPI_CAM_1       1   // 1: Enabled, 0: Disabled  (serial_c => CSI Port 2 => VI Stream 2)
// ------------------------------------------------------------------------------------------------
//  Supported number of lanes
// -----+------------------------------------------------------------------------------------------
//  1   | OV7251, IMX296, IMX297
//  2   | OV9281, IMX264, IMX265
//  2,4 | IMX178, IMX183, IMX226, IMX250, IMX252, IMX273, IMX290, IMX327, IMX335, IMX392, 
//      | IMX412, IMX415, IMX462, IMX540, IMX565, IMX566, IMX567, IMX568, IMX585, IMX900, AR2020
// -----+------------------------------------------------------------------------------------------
#define VC_MIPI_LANES       4   // // CAMO: 1, 2 Lanes, CAM1: 1, 2, 4 Lanes
// ------------------------------------------------------------------------------------------------
//  Embedded Metadata Height
// -----+------------------------------------------------------------------------------------------
//  0   | IMX178, IMX183, IMX226, IMX250, IMX252, IMX264, IMX265, IMX273, IMX392, IMX540, 
//      | OV7251, OV9281, AR2020
//  1   | IMX290, IMX327, IMX335, IMX415, IMX462, IMX565, IMX566, IMX567, IMX568, IMX900
//  2   | IMX296, IMX297, IMX412, IMX585
// -----+------------------------------------------------------------------------------------------
#define VC_MIPI_METADATA_H  "0" // "0", "1", "2" Lines of meta data
// ------------------------------------------------------------------------------------------------
//   Sensor Manufacturer
// -----+------------------------------------------------------------------------------------------
//   1  | Sony Sensor (IMX)         0x1a
//   2  | Omni Vision Sensor (OV)   0x60
//   3  | Onsemi Sensor (AR2020)    0x36
// -----+------------------------------------------------------------------------------------------
#define VC_MIPI_MANUFACTURER 3
// ------------------------------------------------------------------------------------------------
//  GStreamer Support
// ------------------------------------------------------------------------------------------------
//  If you want to use GStreamer with nvarguscamerasrc you have to adjust this settings in the 
//  device tree below. The sections which have to be modified are marked by a comment. 
//  To find the correct parameter values please follow the instruction in the main README.md of 
//  this repository https://github.com/VC-MIPI-modules/vc_mipi_nvidia#gstreamer-support
// ------------------------------------------------------------------------------------------------

#if VC_MIPI_LANES == 1
        #define BUS_WIDTH 1
        #define NUM_LANES "1" 
        #define NUM_CSI_LANES 2
        #define PIX_CLK_HZ "150000000"
#endif
#if VC_MIPI_LANES == 2
        #define BUS_WIDTH 2
        #define NUM_LANES "2" 
        #define NUM_CSI_LANES 4
        #define PIX_CLK_HZ "300000000"
#endif
#if VC_MIPI_LANES == 4
        #define BUS_WIDTH 4
        #define NUM_LANES "4" 
        #define NUM_CSI_LANES 8
        #define PIX_CLK_HZ "600000000"
#endif

// ------------------------------------------------------------------------------------------------
//  Enabling/disabling a camera
// ------------------------------------------------------------------------------------------------
//  All VI ports, NVCSI channels, I2C mux channels and sensor nodes always stay in the device tree
//  and num-channels is always 2. A camera is switched off by status = "disabled" in its VI
//  endpoint (no VI channel, no /dev/videoN) and in its sensor node (no driver probe).
//  Reason (nvidia-oot l4t-r36.5):
//    - NVCSI csi_parse_dt() needs channel@0 .. channel@(num-channels - 1) and ignores status.
//    - VI rejects a port whose reg is >= num-channels ("wrong channel number").
//    - VI tegra_vi_graph_init() skips endpoints and remotes that are disabled.
//  Do not disable the mux channels i2c@0/i2c@1: i2c-mux-gpio only registers available channels,
//  which would change the I2C bus numbers used in devname.
// ------------------------------------------------------------------------------------------------
#if VC_MIPI_CAM_0 == 1
        #define VC_CAM0_STATUS  "okay"
#else
        #define VC_CAM0_STATUS  "disabled"
#endif
#if VC_MIPI_CAM_1 == 1
        #define VC_CAM1_STATUS  "okay"
#else
        #define VC_CAM1_STATUS  "disabled"
#endif

#define BUS_WIDTH_2 2
#define NUM_LANES_2 "2" 

#if VC_MIPI_MANUFACTURER == 1
        #define VC_SEN_ADDR     0x1a
        #define VC_SEN_NODE     vc_mipi@1a
        #define VC_DEVNAME_0    "vc_mipi 10-001a"
        #define VC_DEVNAME_1    "vc_mipi 9-001a"
        #define VC_SYSFS_0      "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/vc_mipi@1a"
        #define VC_SYSFS_1      "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/vc_mipi@1a"
#elif VC_MIPI_MANUFACTURER == 2
        #define VC_SEN_ADDR     0x60
        #define VC_SEN_NODE     vc_mipi@60
        #define VC_DEVNAME_0    "vc_mipi 10-0060"
        #define VC_DEVNAME_1    "vc_mipi 9-0060"
        #define VC_SYSFS_0      "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/vc_mipi@60"
        #define VC_SYSFS_1      "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/vc_mipi@60"
#elif VC_MIPI_MANUFACTURER == 3
        #define VC_SEN_ADDR     0x36
        #define VC_SEN_NODE     vc_mipi@36
        #define VC_DEVNAME_0    "vc_mipi 10-0036"
        #define VC_DEVNAME_1    "vc_mipi 9-0036"
        #define VC_SYSFS_0      "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/vc_mipi@36"
        #define VC_SYSFS_1      "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/vc_mipi@36"
#else
        #error "VC_MIPI_MANUFACTURER must be 1 (Sony), 2 (OmniVision) or 3 (Onsemi)"
#endif

/ {
        overlay-name = "Camera VCMIPI Dual";
        jetson-header-name = "Jetson 24pin CSI Connector";
        compatible = JETSON_COMPATIBLE_P3768;

        fragment@0 {
                target-path = "/";
                __overlay__ {
                        tegra-capture-vi  {
                                num-channels = <2>;
                                ports {
                                        #address-cells = <1>;
                                        #size-cells = <0>;
                                        vc_vi_port0: port@0 {
                                                reg = <0>;
                                                vc_vi_in0: endpoint {
                                                        status = VC_CAM0_STATUS;
                                                        port-index = <1>;
                                                        bus-width = <BUS_WIDTH_2>;
                                                        remote-endpoint = <&vc_csi_out0>;
                                                };
                                        };
                                        vc_vi_port1: port@1 {
                                                reg = <1>;
                                                vc_vi_in1: endpoint {
                                                        status = VC_CAM1_STATUS;
                                                        port-index = <2>;
                                                        bus-width = <BUS_WIDTH>;
                                                        remote-endpoint = <&vc_csi_out1>;
                                                };
                                        };
                                }; // ports
                        };
                        tegra-camera-platform {
                                compatible = "nvidia, tegra-camera-platform";

                                num_csi_lanes = <NUM_CSI_LANES>;
                                max_lane_speed = <1500000>;
                                min_bits_per_pixel = <10>;
                                vi_peak_byte_per_pixel = <2>;
                                vi_bw_margin_pct = <25>;
                                max_pixel_rate = <750000>;
                                isp_peak_byte_per_pixel = <5>;
                                isp_bw_margin_pct = <25>;

                                modules {
#if VC_MIPI_CAM_0 == 1
                                        cam_module0: module0 {
                                                badge = "jakku_front_vc_mipi";
                                                position = "front";
                                                orientation = "1";

                                                cam_module0_drivernode0: drivernode0 {
                                                        pcl_id = "v4l2_sensor";
                                                        devname = VC_DEVNAME_0;
                                                        sysfs-device-tree = VC_SYSFS_0;
                                                };

                                                cam_module0_drivernode1: drivernode1 {
                                                        pcl_id = "v4l2_lens";
                                                        sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/lens@vc_mipi";
                                                };
                                        };
#endif // VC_MIPI_CAM_0

#if VC_MIPI_CAM_1 == 1
                                        cam_module1: module1 {
                                                badge = "jakku_rear_vc_mipi";
                                                position = "rear";
                                                orientation = "1";

                                                cam_module1_drivernode0: drivernode0 {
                                                        pcl_id = "v4l2_sensor";
                                                        devname = VC_DEVNAME_1;
                                                        sysfs-device-tree = VC_SYSFS_1;
                                                };

                                                cam_module1_drivernode1: drivernode1 {
                                                        pcl_id = "v4l2_lens";
                                                        sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/lens@vc_mipi/";
                                                };
                                        };
#endif // VC_MIPI_CAM_1
                                };
                        };
                        bus@0 {
                                host1x@13e00000 {
                                        nvcsi@15a00000 {
                                                num-channels = <2>;
                                                #address-cells = <1>;
                                                #size-cells = <0>;

                                                vc_csi_chan0: channel@0 {
                                                        reg = <0>;
                                                        ports {
                                                                #address-cells = <1>;
                                                                #size-cells = <0>;
                                                                vc_csi_chan0_port0: port@0 {
                                                                        reg = <0>;
                                                                        vc_csi_in0: endpoint@0 {
                                                                                port-index = <1>;
                                                                                bus-width = <BUS_WIDTH_2>;
                                                                                remote-endpoint = <&vc_mipi_out0>;
                                                                        };
                                                                };
                                                                vc_csi_chan0_port1: port@1 {
                                                                        reg = <1>;
                                                                        vc_csi_out0: endpoint@1 {
                                                                                remote-endpoint = <&vc_vi_in0>;
                                                                        };
                                                                };
                                                        };
                                                };
                                                vc_csi_chan1: channel@1 {
                                                        reg = <1>;
                                                        ports {
                                                                #address-cells = <1>;
                                                                #size-cells = <0>;
                                                                vc_csi_chan1_port0: port@0 {
                                                                        reg = <0>;
                                                                        vc_csi_in1: endpoint@2 {
                                                                                port-index = <2>;
                                                                                bus-width = <BUS_WIDTH>;
                                                                                remote-endpoint = <&vc_mipi_out1>;
                                                                        };
                                                                };
                                                                vc_csi_chan1_port1: port@1 {
                                                                        reg = <1>;
                                                                        vc_csi_out1: endpoint@3 {
                                                                                remote-endpoint = <&vc_vi_in1>;
                                                                        };
                                                                };
                                                        };
                                                };
                                        };
                                };

                                cam_i2cmux {
                                        status = "okay";
                                        compatible = "i2c-mux-gpio";
                                        #address-cells = <1>;
                                        #size-cells = <0>;
                                        mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;
                                        i2c-parent = <&cam_i2c>;

                                        i2c@0 {
                                                status = "okay";
                                                reg = <0>;
                                                #address-cells = <1>;
                                                #size-cells = <0>;

                                                vc_mipi_cam0: VC_SEN_NODE {
                                                        status                  = VC_CAM0_STATUS;
                                                        reg                     = <VC_SEN_ADDR>;

                                                        compatible              = "nvidia,vc_mipi";
                                                        devnode                 = "video0";
                                                        use_sensor_mode_id      = "false";
                                                        sensor_model            = "vc_mipi";

                                                        trigger_mode            = "0";
                                                        io_mode                 = "0";

                                                        // ----------------------------------------------------
                                                        // If you want to use GStreamer with nvarguscamerasrc
                                                        // you have to adjust this settings
                                                        physical_w              = "7.168";
                                                        physical_h              = "5.376";
                                                        // ----------------------------------------------------
                                                        // This node is needed by the Tegra framework.
                                                        // You don't have to change any settings if just want 
                                                        // to use the V4L API.
                                                        mode0 {
                                                                num_lanes                = NUM_LANES_2;
                                                                tegra_sinterface         = "serial_b";
                                                                embedded_metadata_height = VC_MIPI_METADATA_H;
                                                                readout_orientation      = "0";
                                                                lane_polarity            = "6";

                                                                // ----------------------------------------------------
                                                                // If you want to use GStreamer with nvarguscamerasrc
                                                                // you have to adjust this settings. 
                                                                active_l                 = "0";
                                                                active_t                 = "0";
                                                                active_w                 = "5120";
                                                                active_h                 = "3840";
                                                                mode_type                = "bayer";
                                                                pixel_phase              = "grbg";
                                                                csi_pixel_bit_depth      = "10";

                                                                min_gain_val             = "0";         // mdB
                                                                max_gain_val             = "30000";     // mdB
                                                                step_gain_val            = "100";       // mdB
                                                                default_gain             = "0";         // mdB

                                                                min_exp_time             = "1";         // us
                                                                max_exp_time             = "1000000";   // us
                                                                step_exp_time            = "1";         // us
                                                                default_exp_time         = "10000";     // us

                                                                // For applications like argus_camera, there should 
                                                                // be a minimal frame rate greater than zero!
                                                                min_framerate            = "100";       // mHz
                                                                max_framerate            = "7900";     // mHz
                                                                step_framerate           = "100";       // mHz
                                                                default_framerate        = "7900";     // mHz
                                                                // ----------------------------------------------------

                                                                gain_factor              = "1000";
                                                                exposure_factor          = "1000000";
                                                                framerate_factor         = "1000";
                                                                inherent_gain            = "1";
                                                                min_hdr_ratio            = "1";
                                                                max_hdr_ratio            = "1";

                                                                line_length              = "0";
                                                                phy_mode                 = "DPHY";
                                                                discontinuous_clk        = "no";
                                                                mclk_khz                 = "24000";

                                                                pix_clk_hz               = "299200000";

                                                                mclk_multiplier          = "0.0";		// deprecated
                                                                cil_settletime           = "0";
                                                                dpcm_enable              = "false";

                                                                set_mode_delay_ms        = "100000";
                                                        };

                                                        mode1 {
                                                                num_lanes                = NUM_LANES_2;
                                                                tegra_sinterface         = "serial_b";
                                                                embedded_metadata_height = VC_MIPI_METADATA_H;
                                                                readout_orientation      = "0";
                                                                lane_polarity            = "6";

                                                                // ----------------------------------------------------
                                                                // If you want to use GStreamer with nvarguscamerasrc
                                                                // you have to adjust this settings. 
                                                                active_l                 = "0";
                                                                active_t                 = "0";
                                                                active_w                 = "5120";
                                                                active_h                 = "3840";
                                                                mode_type                = "bayer";
                                                                pixel_phase              = "grbg";
                                                                csi_pixel_bit_depth      = "12";

                                                                min_gain_val             = "0";         // mdB
                                                                max_gain_val             = "30000";     // mdB
                                                                step_gain_val            = "100";       // mdB
                                                                default_gain             = "0";         // mdB

                                                                min_exp_time             = "1";         // us
                                                                max_exp_time             = "1000000";   // us
                                                                step_exp_time            = "1";         // us
                                                                default_exp_time         = "10000";     // us

                                                                // For applications like argus_camera, there should 
                                                                // be a minimal frame rate greater than zero!
                                                                min_framerate            = "100";       // mHz
                                                                max_framerate            = "7900";     // mHz
                                                                step_framerate           = "100";       // mHz
                                                                default_framerate        = "7900";     // mHz
                                                                // ----------------------------------------------------

                                                                gain_factor              = "1000";
                                                                exposure_factor          = "1000000";
                                                                framerate_factor         = "1000";
                                                                inherent_gain            = "1";
                                                                min_hdr_ratio            = "1";
                                                                max_hdr_ratio            = "1";

                                                                line_length              = "0";
                                                                phy_mode                 = "DPHY";
                                                                discontinuous_clk        = "no";
                                                                mclk_khz                 = "24000";

//                                                                pix_clk_hz               = "249333333";
                                                                pix_clk_hz               = "250000000";

                                                                mclk_multiplier          = "0.0";		// deprecated
                                                                cil_settletime           = "0";
                                                                dpcm_enable              = "false";

                                                                set_mode_delay_ms        = "100000";
                                                        };

                                                        mode2 {
                                                                num_lanes                = NUM_LANES_2;
                                                                tegra_sinterface         = "serial_b";
                                                                embedded_metadata_height = VC_MIPI_METADATA_H;
                                                                readout_orientation      = "0";
                                                                lane_polarity            = "6";

                                                                // ----------------------------------------------------
                                                                // If you want to use GStreamer with nvarguscamerasrc
                                                                // you have to adjust this settings. 
                                                                active_l                 = "0";
                                                                active_t                 = "0";
                                                                active_w                 = "5120";
                                                                active_h                 = "3840";
                                                                mode_type                = "bayer";
                                                                pixel_phase              = "grbg";
                                                                csi_pixel_bit_depth      = "8";

                                                                min_gain_val             = "0";         // mdB
                                                                max_gain_val             = "30000";     // mdB
                                                                step_gain_val            = "100";       // mdB
                                                                default_gain             = "0";         // mdB

                                                                min_exp_time             = "1";         // us
                                                                max_exp_time             = "1000000";   // us
                                                                step_exp_time            = "1";         // us
                                                                default_exp_time         = "10000";     // us

                                                                // For applications like argus_camera, there should 
                                                                // be a minimal frame rate greater than zero!
                                                                min_framerate            = "100";       // mHz
                                                                max_framerate            = "7900";     // mHz
                                                                step_framerate           = "100";       // mHz
                                                                default_framerate        = "7900";     // mHz
                                                                // ----------------------------------------------------

                                                                gain_factor              = "1000";
                                                                exposure_factor          = "1000000";
                                                                framerate_factor         = "1000";
                                                                inherent_gain            = "1";
                                                                min_hdr_ratio            = "1";
                                                                max_hdr_ratio            = "1";

                                                                line_length              = "0";
                                                                phy_mode                 = "DPHY";
                                                                discontinuous_clk        = "no";
                                                                mclk_khz                 = "24000";

                                                                pix_clk_hz               = "374000000";

                                                                mclk_multiplier          = "0.0";		// deprecated
                                                                cil_settletime           = "0";
                                                                dpcm_enable              = "false";

                                                                set_mode_delay_ms        = "100000";
                                                        };

                                                        ports {
                                                                #address-cells = <1>;
                                                                #size-cells = <0>;
                                                                port@0 {
                                                                        reg = <0>;
                                                                        vc_mipi_out0: endpoint {
                                                                                port-index = <1>;
                                                                                bus-width = <BUS_WIDTH_2>;
                                                                                remote-endpoint = <&vc_csi_in0>;
                                                                        };
                                                                };
                                                        };
                                                };
                                        };

                                        i2c@1 {
                                                status = "okay";
                                                reg = <1>;
                                                #address-cells = <1>;
                                                #size-cells = <0>;

                                                vc_mipi_cam1: VC_SEN_NODE {
                                                        status                  = VC_CAM1_STATUS;
                                                        reg                     = <VC_SEN_ADDR>;

                                                        compatible              = "nvidia,vc_mipi";
                                                        devnode                 = "video1";
                                                        use_sensor_mode_id      = "false";
                                                        sensor_model            = "vc_mipi";

                                                        trigger_mode            = "0";
                                                        io_mode                 = "0";

                                                        // ----------------------------------------------------
                                                        // If you want to use GStreamer with nvarguscamerasrc
                                                        // you have to adjust this settings
                                                        physical_w              = "7.168";
                                                        physical_h              = "5.376";
                                                        // ----------------------------------------------------

                                                        mode0 {
                                                                num_lanes                = NUM_LANES;
                                                                tegra_sinterface         = "serial_c";
                                                                embedded_metadata_height = VC_MIPI_METADATA_H;
                                                                readout_orientation      = "0";
                                                                lane_polarity            = "0";

                                                                // ----------------------------------------------------
                                                                // If you want to use GStreamer with nvarguscamerasrc
                                                                // you have to adjust this settings. 
                                                                active_l                 = "0";
                                                                active_t                 = "0";
                                                                active_w                 = "5120";
                                                                active_h                 = "3840";
                                                                mode_type                = "bayer";
                                                                pixel_phase              = "grbg";
                                                                csi_pixel_bit_depth      = "10";

                                                                min_gain_val             = "0";         // mdB
                                                                max_gain_val             = "30000";     // mdB
                                                                step_gain_val            = "100";       // mdB
                                                                default_gain             = "0";         // mdB

                                                                min_exp_time             = "1";         // us
                                                                max_exp_time             = "1000000";   // us
                                                                step_exp_time            = "1";         // us
                                                                default_exp_time         = "10000";     // us

                                                                // For applications like argus_camera, there should 
                                                                // be a minimal frame rate greater than zero!
                                                                min_framerate            = "100";       // mHz
                                                                max_framerate            = "17700";     // mHz
                                                                step_framerate           = "100";       // mHz
                                                                default_framerate        = "17700";     // mHz
                                                                // ----------------------------------------------------

                                                                gain_factor              = "1000";
                                                                exposure_factor          = "1000000";
                                                                framerate_factor         = "1000";
                                                                inherent_gain            = "1";
                                                                min_hdr_ratio            = "1";
                                                                max_hdr_ratio            = "1";

                                                                line_length              = "0";
                                                                phy_mode                 = "DPHY";
                                                                discontinuous_clk        = "no";
                                                                mclk_khz                 = "24000";

                                                                pix_clk_hz               = "598400000";

                                                                mclk_multiplier          = "0.0";		// deprecated
                                                                cil_settletime           = "0";
                                                                dpcm_enable              = "false";

                                                                set_mode_delay_ms        = "100000";
                                                        };

                                                        mode1 {
                                                                num_lanes                = NUM_LANES;
                                                                tegra_sinterface         = "serial_c";
                                                                embedded_metadata_height = VC_MIPI_METADATA_H;
                                                                readout_orientation      = "0";
                                                                lane_polarity            = "0";

                                                                // ----------------------------------------------------
                                                                // If you want to use GStreamer with nvarguscamerasrc
                                                                // you have to adjust this settings. 
                                                                active_l                 = "0";
                                                                active_t                 = "0";
                                                                active_w                 = "5120";
                                                                active_h                 = "3840";
                                                                mode_type                = "bayer";
                                                                pixel_phase              = "grbg";
                                                                csi_pixel_bit_depth      = "12";

                                                                min_gain_val             = "0";         // mdB
                                                                max_gain_val             = "30000";     // mdB
                                                                step_gain_val            = "100";       // mdB
                                                                default_gain             = "0";         // mdB

                                                                min_exp_time             = "1";         // us
                                                                max_exp_time             = "1000000";   // us
                                                                step_exp_time            = "1";         // us
                                                                default_exp_time         = "10000";     // us

                                                                // For applications like argus_camera, there should 
                                                                // be a minimal frame rate greater than zero!
                                                                min_framerate            = "100";       // mHz
                                                                max_framerate            = "14000";     // mHz
                                                                step_framerate           = "100";       // mHz
                                                                default_framerate        = "14000";     // mHz
                                                                // ----------------------------------------------------

                                                                gain_factor              = "1000";
                                                                exposure_factor          = "1000000";
                                                                framerate_factor         = "1000";
                                                                inherent_gain            = "1";
                                                                min_hdr_ratio            = "1";
                                                                max_hdr_ratio            = "1";

                                                                line_length              = "0";
                                                                phy_mode                 = "DPHY";
                                                                discontinuous_clk        = "no";
                                                                mclk_khz                 = "24000";

//                                                                pix_clk_hz               = "498666666";
                                                                pix_clk_hz               = "500000000";

                                                                mclk_multiplier          = "0.0";		// deprecated
                                                                cil_settletime           = "0";
                                                                dpcm_enable              = "false";

                                                                set_mode_delay_ms        = "100000";
                                                        };

                                                        mode2 {
                                                                num_lanes                = NUM_LANES;
                                                                tegra_sinterface         = "serial_c";
                                                                embedded_metadata_height = VC_MIPI_METADATA_H;
                                                                readout_orientation      = "0";
                                                                lane_polarity            = "0";

                                                                // ----------------------------------------------------
                                                                // If you want to use GStreamer with nvarguscamerasrc
                                                                // you have to adjust this settings. 
                                                                active_l                 = "0";
                                                                active_t                 = "0";
                                                                active_w                 = "5120";
                                                                active_h                 = "3840";
                                                                mode_type                = "bayer";
                                                                pixel_phase              = "grbg";
                                                                csi_pixel_bit_depth      = "8";

                                                                min_gain_val             = "0";         // mdB
                                                                max_gain_val             = "30000";     // mdB
                                                                step_gain_val            = "100";       // mdB
                                                                default_gain             = "0";         // mdB

                                                                min_exp_time             = "1";         // us
                                                                max_exp_time             = "1000000";   // us
                                                                step_exp_time            = "1";         // us
                                                                default_exp_time         = "10000";     // us

                                                                // For applications like argus_camera, there should 
                                                                // be a minimal frame rate greater than zero!
                                                                min_framerate            = "100";       // mHz
                                                                max_framerate            = "17700";     // mHz
                                                                step_framerate           = "100";       // mHz
                                                                default_framerate        = "17700";     // mHz
                                                                // ----------------------------------------------------

                                                                gain_factor              = "1000";
                                                                exposure_factor          = "1000000";
                                                                framerate_factor         = "1000";
                                                                inherent_gain            = "1";
                                                                min_hdr_ratio            = "1";
                                                                max_hdr_ratio            = "1";

                                                                line_length              = "0";
                                                                phy_mode                 = "DPHY";
                                                                discontinuous_clk        = "no";
                                                                mclk_khz                 = "24000";

                                                                pix_clk_hz               = "748000000";

                                                                mclk_multiplier          = "0.0";		// deprecated
                                                                cil_settletime           = "0";
                                                                dpcm_enable              = "false";

                                                                set_mode_delay_ms        = "100000";
                                                        };

                                                        ports {
                                                                #address-cells = <1>;
                                                                #size-cells = <0>;
                                                                port@0 {
                                                                        reg = <0>;
                                                                        vc_mipi_out1: endpoint {
                                                                                port-index = <2>;
                                                                                bus-width = <BUS_WIDTH>;
                                                                                remote-endpoint = <&vc_csi_in1>;
                                                                        };
                                                                };
                                                        };
                                                };
                                        };

                                };

                                lens@vc_mipi {
                                        min_focus_distance  = "0.0";
                                        hyper_focal         = "0.0";
                                        focal_length        = "6.0";
                                        f_number            = "2.0";
                                        aperture            = "0.0";
                                };

                        };
                };
        };
};
